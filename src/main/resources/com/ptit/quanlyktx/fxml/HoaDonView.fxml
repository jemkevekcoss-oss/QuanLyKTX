<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.VBox?>

<!-- Chi thay doi giao dien: giu nguyen fx:id va onAction cua HoaDonController.java -->
<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.ptit.quanlyktx.controller.HoaDonController"
      stylesheets="@../css/hoadon.css"
      styleClass="bill-page" spacing="16" fillWidth="true">

    <!-- Hai the tong hop, so lieu do Controller cap nhat tu MySQL -->
    <HBox spacing="14" fillHeight="true">
        <HBox spacing="15" alignment="CENTER_LEFT"
              styleClass="bill-stat-card,bill-stat-students" HBox.hgrow="ALWAYS">
            <VBox spacing="7" HBox.hgrow="ALWAYS">
                <Label text="SỐ SINH VIÊN TRONG KẾT QUẢ" styleClass="bill-stat-label"/>
                <Label fx:id="lblSoSinhVien" text="—" styleClass="bill-stat-value"/>
                <Label text="Theo kỳ và bộ lọc đã chọn" styleClass="bill-stat-note"/>
            </VBox>
            <Label text="SV" styleClass="bill-stat-icon,bill-stat-icon-students"/>
        </HBox>
        <HBox spacing="15" alignment="CENTER_LEFT"
              styleClass="bill-stat-card,bill-stat-total" HBox.hgrow="ALWAYS">
            <VBox spacing="7" HBox.hgrow="ALWAYS">
                <Label text="TỔNG PHẢI TRẢ" styleClass="bill-stat-label"/>
                <Label fx:id="lblTongTien" text="—" styleClass="bill-stat-value"/>
                <Label text="Tiền phòng + dịch vụ + gửi xe" styleClass="bill-stat-note"/>
            </VBox>
            <Label text="₫" styleClass="bill-stat-icon,bill-stat-icon-total"/>
        </HBox>
    </HBox>

    <!-- Khung bao cao chinh -->
    <VBox spacing="14" styleClass="bill-panel" VBox.vgrow="ALWAYS">
        <HBox alignment="CENTER_LEFT" spacing="12">
            <VBox spacing="5" HBox.hgrow="ALWAYS">
                <Label text="Tổng hợp thanh toán hằng tháng" styleClass="bill-panel-title"/>
                <Label text="Tiền phòng, dịch vụ, vé xe tháng và phí gửi xe phát sinh"
                       styleClass="bill-panel-subtitle"/>
            </VBox>
            <Label text="BÁO CÁO THÁNG" styleClass="bill-panel-tag"/>
        </HBox>

        <!-- Bo loc: khong doi event, khong doi giao tiep Controller -->
        <HBox spacing="12" alignment="BOTTOM_LEFT" styleClass="bill-filter-bar">
            <VBox spacing="6">
                <Label text="Tháng (YYYY-MM)" styleClass="bill-field-label"/>
                <TextField fx:id="txtThang" prefWidth="160" prefHeight="39"
                           promptText="2026-11" styleClass="bill-input"/>
            </VBox>
            <VBox spacing="6" HBox.hgrow="ALWAYS">
                <Label text="Sinh viên" styleClass="bill-field-label"/>
                <ComboBox fx:id="cmbSinhVien" prefHeight="39" maxWidth="1.7976931348623157E308"
                          promptText="Tất cả sinh viên" styleClass="bill-select"/>
            </VBox>
            <Button text="Tra cứu" onAction="#handleSearch"
                    styleClass="bill-primary-button" prefHeight="39"/>
            <Button text="Làm mới" onAction="#handleRefresh"
                    styleClass="bill-neutral-button" prefHeight="39"/>
        </HBox>

        <HBox alignment="CENTER_LEFT" spacing="8">
            <Label text="CHI TIẾT THEO SINH VIÊN" styleClass="bill-table-title"/>
        </HBox>
        <TableView fx:id="tableBills" prefHeight="430" VBox.vgrow="ALWAYS"
                   styleClass="bill-table">
            <placeholder>
                <Label text="Không có dữ liệu thanh toán trong tháng đã chọn" styleClass="bill-empty"/>
            </placeholder>
            <columns>
                <TableColumn fx:id="colMaSV" text="Mã SV" prefWidth="111"/>
                <TableColumn fx:id="colHoTen" text="Họ tên" prefWidth="175"/>
                <TableColumn fx:id="colPhong" text="Phòng" prefWidth="75"/>
                <TableColumn fx:id="colTienPhong" text="Tiền phòng" prefWidth="130" styleClass="bill-money-col"/>
                <TableColumn fx:id="colTienDichVu" text="Dịch vụ" prefWidth="120" styleClass="bill-money-col"/>
                <TableColumn fx:id="colTienVeXe" text="Vé xe tháng" prefWidth="120" styleClass="bill-money-col"/>
                <TableColumn fx:id="colTienPhatSinh" text="Phí phát sinh" prefWidth="124" styleClass="bill-money-col"/>
                <TableColumn fx:id="colTongTien" text="Tổng phải trả" prefWidth="150" styleClass="bill-money-col,bill-total-col"/>
            </columns>
        </TableView>

        <!-- Footer voi thong tin trang thai + nut in -->
        <HBox spacing="10" alignment="CENTER_RIGHT" styleClass="bill-footer">
            <Label fx:id="lblCount" text="Hiển thị: 0 sinh viên" HBox.hgrow="ALWAYS"
                   styleClass="bill-footer-count"/>
            <Button text="In danh sách" onAction="#handlePrintAll" styleClass="bill-print-button"/>
            <Button text="In sinh viên đã chọn" onAction="#handlePrintOne" styleClass="bill-print-button"/>
        </HBox>
    </VBox>
</VBox>
