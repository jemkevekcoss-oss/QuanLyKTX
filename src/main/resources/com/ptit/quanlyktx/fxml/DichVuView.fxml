<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- Được nạp vào contentArea của MainView.fxml, không tạo Sidebar lần nữa. -->
<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.ptit.quanlyktx.controller.DichVuController"
      stylesheets="@../css/dichvu.css"
      styleClass="svc-page" spacing="12" fillWidth="true">

    <!-- 3 thẻ tổng quan: số liệu đọc từ các bảng MySQL -->
    <HBox spacing="12" fillHeight="true">
        <VBox spacing="7" styleClass="svc-stat-card"
              HBox.hgrow="ALWAYS" maxWidth="1.7976931348623157E308">
            <Label text="Tổng dịch vụ" styleClass="svc-muted"/>
            <Label fx:id="lblTotalServices" text="—" styleClass="svc-stat-number"/>
        </VBox>
        <VBox spacing="7" styleClass="svc-stat-card"
              HBox.hgrow="ALWAYS" maxWidth="1.7976931348623157E308">
            <Label text="Lượt sử dụng tháng này" styleClass="svc-muted"/>
            <Label fx:id="lblMonthUses" text="—" styleClass="svc-stat-number"/>
        </VBox>
        <VBox spacing="7" styleClass="svc-stat-card"
              HBox.hgrow="ALWAYS" maxWidth="1.7976931348623157E308">
            <Label text="Tổng tiền dịch vụ tháng" styleClass="svc-muted"/>
            <Label fx:id="lblMonthMoney" text="—" styleClass="svc-stat-number"/>
        </VBox>
    </HBox>

    <!-- Ba tab với mục đích riêng biệt: 2 CRUD và 1 báo cáo -->
    <TabPane fx:id="tabPane" tabClosingPolicy="UNAVAILABLE"
             styleClass="svc-tabs" VBox.vgrow="ALWAYS" prefHeight="560">
        <tabs>
            <Tab fx:id="tabCatalog" text="Danh mục dịch vụ">
                <content>
                    <VBox spacing="11" styleClass="svc-panel" fillWidth="true">
                        <Label text="Danh sách dịch vụ ký túc xá" styleClass="svc-panel-title"/>
                        <HBox spacing="8" alignment="CENTER_LEFT">
                            <TextField fx:id="txtServiceSearch" HBox.hgrow="ALWAYS"
                                       promptText="Tìm mã dịch vụ, tên dịch vụ hoặc đơn vị tính..."
                                       prefHeight="38"/>
                            <Button text="+ Thêm dịch vụ" onAction="#handleAddService"
                                    styleClass="svc-primary-button"/>
                            <Button text="Sửa" onAction="#handleEditService" styleClass="svc-button"/>
                            <Button text="Xóa" onAction="#handleDeleteService" styleClass="svc-button"/>
                            <Button text="Làm mới" onAction="#handleRefreshCatalog" styleClass="svc-button"/>
                        </HBox>
                        <TableView fx:id="tableServices" styleClass="svc-table"
                                   prefHeight="330" VBox.vgrow="ALWAYS">
                            <placeholder><Label text="Chưa có dịch vụ phù hợp"/></placeholder>
                            <columns>
                                <TableColumn fx:id="colMaDV" text="Mã DV" prefWidth="145"/>
                                <TableColumn fx:id="colTenDV" text="Tên dịch vụ" prefWidth="310"/>
                                <TableColumn fx:id="colDonGia" text="Đơn giá (VNĐ)" prefWidth="160"/>
                                <TableColumn fx:id="colDonViTinh" text="Đơn vị tính" prefWidth="135"/>
                            </columns>
                        </TableView>
                        <Label fx:id="lblCatalogCount" text="Hiển thị: 0 dịch vụ" styleClass="svc-footnote"/>
                    </VBox>
                </content>
            </Tab>

            <Tab fx:id="tabHistory" text="Lịch sử sử dụng">
                <content>
                    <VBox spacing="11" styleClass="svc-panel" fillWidth="true">
                        <Label text="Lịch sử sử dụng dịch vụ" styleClass="svc-panel-title"/>
                        <Label text="Mỗi dòng là một lần sinh viên sử dụng dịch vụ; sắp theo thời gian từ sớm đến muộn."
                               styleClass="svc-footnote"/>
                        <HBox spacing="8" alignment="CENTER_LEFT">
                            <TextField fx:id="txtHistorySearch" HBox.hgrow="ALWAYS"
                                       promptText="Tìm mã sử dụng, sinh viên hoặc dịch vụ..."
                                       prefHeight="38"/>
                            <Button text="+ Ghi nhận" onAction="#handleAddUsage"
                                    styleClass="svc-primary-button"/>
                            <Button text="Sửa" onAction="#handleEditUsage" styleClass="svc-button"/>
                            <Button text="Xóa" onAction="#handleDeleteUsage" styleClass="svc-button"/>
                            <Button text="Làm mới" onAction="#handleRefreshHistory" styleClass="svc-button"/>
                        </HBox>
                        <TableView fx:id="tableUsages" styleClass="svc-table"
                                   prefHeight="315" VBox.vgrow="ALWAYS">
                            <placeholder><Label text="Chưa có lượt sử dụng phù hợp"/></placeholder>
                            <columns>
                                <TableColumn fx:id="colIdSuDung" text="ID lượt" prefWidth="70"/>
                                <TableColumn fx:id="colMaSV" text="Mã SV" prefWidth="118"/>
                                <TableColumn fx:id="colHoTen" text="Họ tên SV" prefWidth="160"/>
                                <TableColumn fx:id="colLichSuDV" text="Dịch vụ" prefWidth="170"/>
                                <TableColumn fx:id="colThoiGian" text="Thời gian sử dụng" prefWidth="140"/>
                                <TableColumn fx:id="colSoLuong" text="Số lượng" prefWidth="105"/>
                                <TableColumn fx:id="colThanhTien" text="Thành tiền" prefWidth="120"/>
                            </columns>
                        </TableView>
                        <Label fx:id="lblHistoryCount" text="Hiển thị: 0 lượt sử dụng" styleClass="svc-footnote"/>
                    </VBox>
                </content>
            </Tab>

            <Tab fx:id="tabReport" text="Thống kê sử dụng dịch vụ">
                <content>
                    <VBox spacing="13" styleClass="svc-panel" fillWidth="true">
                        <Label text="Tổng hợp chi phí sử dụng dịch vụ" styleClass="svc-panel-title"/>
                        <Label text="Liệt kê sinh viên và tổng chi phí từng dịch vụ trong khoảng thời gian được chọn."
                               styleClass="svc-footnote"/>
                        <HBox spacing="10" alignment="BOTTOM_LEFT">
                            <VBox spacing="5" HBox.hgrow="ALWAYS" maxWidth="1.7976931348623157E308">
                                <Label text="Ngày bắt đầu" styleClass="svc-muted"/>
                                <DatePicker fx:id="dpFrom" maxWidth="1.7976931348623157E308" prefHeight="38"/>
                            </VBox>
                            <VBox spacing="5" HBox.hgrow="ALWAYS" maxWidth="1.7976931348623157E308">
                                <Label text="Ngày kết thúc" styleClass="svc-muted"/>
                                <DatePicker fx:id="dpTo" maxWidth="1.7976931348623157E308" prefHeight="38"/>
                            </VBox>
                            <Button text="Tra cứu" onAction="#handleRunReport" styleClass="svc-primary-button"/>
                        </HBox>
                        <HBox alignment="CENTER_LEFT" spacing="8">
                            <Label text="Bảng tổng hợp chi phí theo sinh viên và dịch vụ" styleClass="svc-panel-subtitle"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label fx:id="lblReportTotal" text="Tổng cộng: —" styleClass="svc-report-total"/>
                        </HBox>
                        <TableView fx:id="tableReport" styleClass="svc-table"
                                   prefHeight="335" VBox.vgrow="ALWAYS">
                            <placeholder><Label text="Không có phát sinh trong khoảng ngày này"/></placeholder>
                            <columns>
                                <TableColumn fx:id="colTKMaSV" text="Mã SV" prefWidth="130"/>
                                <TableColumn fx:id="colTKHoTen" text="Họ và tên" prefWidth="190"/>
                                <TableColumn fx:id="colTKTenDV" text="Tên dịch vụ" prefWidth="250"/>
                                <TableColumn fx:id="colTKSLSuDung" text="Số lượng" prefWidth="115"/>
                                <TableColumn fx:id="colTKTongTien" text="Tổng tiền (VNĐ)" prefWidth="155"/>
                            </columns>
                        </TableView>
                        <Label fx:id="lblReportCount" text="Kết quả: 0 dòng" styleClass="svc-footnote"/>
                    </VBox>
                </content>
            </Tab>
        </tabs>
    </TabPane>

    <HBox alignment="CENTER_RIGHT" spacing="8">
        <Button text="Xem doanh thu dịch vụ  ›" onAction="#handleNavigateRevenue"
                styleClass="svc-link-button"/>
    </HBox>
</VBox>
