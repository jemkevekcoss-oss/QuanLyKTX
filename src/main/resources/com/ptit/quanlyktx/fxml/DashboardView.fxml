<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns:fx="http://javafx.com/fxml" fx:controller="com.ptit.quanlyktx.controller.DashboardController"
      spacing="17" styleClass="dash-root" stylesheets="@../css/dashboard.css">
    <padding><Insets top="13" right="18" bottom="16" left="18"/></padding>

    <!-- MainView.fxml da co tieu de trang; chi giu nut Lam moi de tranh lap tieu de -->
    <HBox alignment="CENTER_RIGHT">
        <Button text="↻  Làm mới" onAction="#lamMoi" styleClass="dash-refresh"/>
    </HBox>

    <HBox spacing="13">
        <VBox spacing="8" HBox.hgrow="ALWAYS" maxWidth="Infinity" styleClass="dash-kpi, dash-kpi-blue">
            <HBox alignment="CENTER_LEFT" spacing="10"><Label text="♟" styleClass="dash-kpi-icon, dash-text-blue"/><Label text="Tổng sinh viên" styleClass="dash-kpi-label"/></HBox>
            <Label fx:id="lblTongSinhVien" text="—" styleClass="dash-kpi-value, dash-text-blue"/>
        </VBox>
        <VBox spacing="8" HBox.hgrow="ALWAYS" maxWidth="Infinity" styleClass="dash-kpi, dash-kpi-green">
            <HBox alignment="CENTER_LEFT" spacing="10"><Label text="▦" styleClass="dash-kpi-icon, dash-text-green"/><Label text="Tổng số phòng" styleClass="dash-kpi-label"/></HBox>
            <Label fx:id="lblTongPhong" text="—" styleClass="dash-kpi-value, dash-text-green"/>
        </VBox>
        <VBox spacing="8" HBox.hgrow="ALWAYS" maxWidth="Infinity" styleClass="dash-kpi, dash-kpi-orange">
            <HBox alignment="CENTER_LEFT" spacing="10"><Label text="▤" styleClass="dash-kpi-icon, dash-text-orange"/><Label text="Chỗ còn trống" styleClass="dash-kpi-label"/></HBox>
            <Label fx:id="lblChoTrong" text="—" styleClass="dash-kpi-value, dash-text-orange"/>
        </VBox>
        <VBox spacing="8" HBox.hgrow="ALWAYS" maxWidth="Infinity" styleClass="dash-kpi, dash-kpi-purple">
            <HBox alignment="CENTER_LEFT" spacing="10"><Label text="◈" styleClass="dash-kpi-icon, dash-text-purple"/><Label text="Dịch vụ hiện có" styleClass="dash-kpi-label"/></HBox>
            <Label fx:id="lblTongDichVu" text="—" styleClass="dash-kpi-value, dash-text-purple"/>
        </VBox>
    </HBox>

    <HBox spacing="14" alignment="TOP_LEFT">
        <VBox spacing="17" styleClass="dash-panel" HBox.hgrow="ALWAYS" maxWidth="Infinity">
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label text="▣" styleClass="dash-panel-icon"/>
                <Label text="Sức chứa ký túc xá" styleClass="dash-panel-title"/>
            </HBox>
            <HBox spacing="18" alignment="CENTER_LEFT">
                <!-- Circle/Arc can co tam co dinh. Neu dat Arc truc tiep trong StackPane,
                     layoutBounds cua Arc thay doi theo length va lam lech vong cung. -->
                <StackPane prefWidth="203" prefHeight="203" minWidth="203" minHeight="203" maxWidth="203" maxHeight="203">
                    <Pane prefWidth="203" prefHeight="203" minWidth="203" minHeight="203" maxWidth="203" maxHeight="203" mouseTransparent="true">
                        <Circle centerX="101.5" centerY="101.5" radius="78"
                                fill="TRANSPARENT" stroke="#E0E7F0" strokeWidth="23"/>
                        <Arc fx:id="arcDaO" centerX="101.5" centerY="101.5" radiusX="78" radiusY="78"
                             startAngle="90" length="0" type="OPEN" fill="TRANSPARENT"
                             stroke="#1769F5" strokeWidth="23" strokeLineCap="BUTT"/>
                    </Pane>
                    <VBox alignment="CENTER" spacing="6" mouseTransparent="true">
                        <Label fx:id="lblTyLe" text="—" styleClass="dash-percent"/>
                        <Label fx:id="lblSucChua" text="— / — chỗ" styleClass="dash-muted"/>
                    </VBox>
                </StackPane>
                <GridPane hgap="11" vgap="11" HBox.hgrow="ALWAYS">
                    <columnConstraints><ColumnConstraints percentWidth="50"/><ColumnConstraints percentWidth="50"/></columnConstraints>
                    <VBox spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="0" styleClass="dash-mini, dash-mini-orange">
                        <Label text="▤  Phòng đầy" styleClass="dash-mini-label"/>
                        <Label fx:id="lblPhongDay" text="—" styleClass="dash-mini-value, dash-text-orange"/>
                    </VBox>
                    <VBox spacing="6" GridPane.columnIndex="1" GridPane.rowIndex="0" styleClass="dash-mini, dash-mini-blue">
                        <Label text="▤  Phòng còn chỗ" styleClass="dash-mini-label"/>
                        <Label fx:id="lblPhongConCho" text="—" styleClass="dash-mini-value, dash-text-blue"/>
                    </VBox>
                    <VBox spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="1" styleClass="dash-mini, dash-mini-teal">
                        <Label text="▤  Phòng trống" styleClass="dash-mini-label"/>
                        <Label fx:id="lblPhongTrong" text="—" styleClass="dash-mini-value, dash-text-teal"/>
                    </VBox>
                    <VBox spacing="6" GridPane.columnIndex="1" GridPane.rowIndex="1" styleClass="dash-mini, dash-mini-green">
                        <Label text="♟  Chỗ còn lại" styleClass="dash-mini-label"/>
                        <Label fx:id="lblChoConLai" text="—" styleClass="dash-mini-value, dash-text-green"/>
                    </VBox>
                </GridPane>
            </HBox>
        </VBox>
        <VBox spacing="10" styleClass="dash-panel" HBox.hgrow="ALWAYS" maxWidth="Infinity">
            <HBox alignment="CENTER_LEFT" spacing="10"><Label text="▣" styleClass="dash-panel-icon"/><Label text="Tình trạng phòng" styleClass="dash-panel-title"/></HBox>
            <Label text="4 phòng có tỷ lệ lấp đầy thấp nhất" styleClass="dash-muted"/>
            <VBox fx:id="danhSachPhong" spacing="7" minHeight="212"/>
            <Button text="Xem tất cả phòng  ›" onAction="#moPhong" maxWidth="Infinity" styleClass="dash-more"/>
        </VBox>
    </HBox>

    <VBox spacing="12" styleClass="dash-panel">
        <Label text="Truy cập nhanh" styleClass="dash-panel-title"/>
        <HBox spacing="12">
            <Button onAction="#moSinhVien" maxWidth="Infinity" HBox.hgrow="ALWAYS" styleClass="dash-shortcut, dash-shortcut-blue">
                <graphic><HBox alignment="CENTER_LEFT" spacing="12"><Label text="+" styleClass="dash-shortcut-icon, dash-text-blue"/><VBox spacing="5"><Label text="Thêm sinh viên" styleClass="dash-shortcut-title"/><Label text="Mở quản lý hồ sơ" styleClass="dash-shortcut-sub"/></VBox></HBox></graphic>
            </Button>
            <Button onAction="#moPhong" maxWidth="Infinity" HBox.hgrow="ALWAYS" styleClass="dash-shortcut, dash-shortcut-green">
                <graphic><HBox alignment="CENTER_LEFT" spacing="12"><Label text="▦" styleClass="dash-shortcut-icon, dash-text-green"/><VBox spacing="5"><Label text="Quản lý phòng" styleClass="dash-shortcut-title"/><Label text="Sức chứa và bố trí" styleClass="dash-shortcut-sub"/></VBox></HBox></graphic>
            </Button>
            <Button onAction="#moHoaDon" maxWidth="Infinity" HBox.hgrow="ALWAYS" styleClass="dash-shortcut, dash-shortcut-amber">
                <graphic><HBox alignment="CENTER_LEFT" spacing="12"><Label text="▤" styleClass="dash-shortcut-icon, dash-text-orange"/><VBox spacing="5"><Label text="Xem hóa đơn" styleClass="dash-shortcut-title"/><Label text="Thanh toán hàng tháng" styleClass="dash-shortcut-sub"/></VBox></HBox></graphic>
            </Button>
            <Button onAction="#moGuiXe" maxWidth="Infinity" HBox.hgrow="ALWAYS" styleClass="dash-shortcut, dash-shortcut-purple">
                <graphic><HBox alignment="CENTER_LEFT" spacing="12"><Label text="▣" styleClass="dash-shortcut-icon, dash-text-purple"/><VBox spacing="5"><Label text="Cấp vé xe" styleClass="dash-shortcut-title"/><Label text="Đăng ký và gia hạn" styleClass="dash-shortcut-sub"/></VBox></HBox></graphic>
            </Button>
        </HBox>
    </VBox>
</VBox>
