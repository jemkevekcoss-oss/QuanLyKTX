<?xml version='1.0' encoding='UTF-8'?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<!-- Nội dung trang Khách thăm; MainView.fxml đang cung cấp sidebar/header bên ngoài. -->
<VBox xmlns:fx="http://javafx.com/fxml" fx:controller="com.ptit.quanlyktx.controller.KhachThamController" spacing="14" styleClass="kt-page" stylesheets="@../css/khachtham.css">
  <padding>
    <Insets top="8" right="20" bottom="14" left="20"/>
  </padding>
  <HBox spacing="12" alignment="CENTER_LEFT">
    <VBox spacing="3" HBox.hgrow="ALWAYS">
      <Label text="QUẢN LÝ HỒ SƠ VÀ LƯỢT KHÁCH" styleClass="kt-eyebrow"/>
      <Label text="Theo dõi khách đến thăm, kiểm soát ra / vào và tổng hợp theo tháng" styleClass="kt-description"/>
    </VBox>
    <Button text="↻  Làm mới" onAction="#lamMoi" styleClass="kt-button-outline"/>
  </HBox>
  <!--Ba the so lieu duoc cap nhat tu Controller; khong lay du lieu demo.-->
  <HBox spacing="14" alignment="CENTER_LEFT" styleClass="kt-stats-row">
    <VBox spacing="7" styleClass="kt-stat-card kt-card-blue" maxWidth="Infinity" minHeight="110" prefHeight="118" style="-fx-background-color: #EAF1FF; -fx-background-radius: 14; -fx-border-color: #CFE0FF; -fx-border-radius: 14; -fx-border-width: 1; -fx-padding: 15 20;" HBox.hgrow="ALWAYS">
      <HBox alignment="CENTER_LEFT" spacing="8">
        <Label text="◈" styleClass="kt-stat-icon"/>
        <Label text="Tổng lượt thăm" styleClass="kt-stat-name"/>
      </HBox>
      <Label text="—" styleClass="kt-stat-number kt-blue-text" fx:id="lblTongLuot" style="-fx-text-fill: #195BC8; -fx-font-weight: bold; -fx-font-size: 30px;"/>
      <Label text="Tất cả lượt đã ghi nhận" styleClass="kt-stat-note"/>
    </VBox>
    <VBox spacing="7" styleClass="kt-stat-card kt-card-green" maxWidth="Infinity" minHeight="110" prefHeight="118" style="-fx-background-color: #E6F7F1; -fx-background-radius: 14; -fx-border-color: #C8EDDF; -fx-border-radius: 14; -fx-border-width: 1; -fx-padding: 15 20;" HBox.hgrow="ALWAYS">
      <HBox alignment="CENTER_LEFT" spacing="8">
        <Label text="◷" styleClass="kt-stat-icon"/>
        <Label text="Lượt đến tháng này" styleClass="kt-stat-name"/>
      </HBox>
      <Label text="—" styleClass="kt-stat-number kt-green-text" fx:id="lblLuotThang" style="-fx-text-fill: #00846C; -fx-font-weight: bold; -fx-font-size: 30px;"/>
      <Label text="Tính theo ngày khách đến" styleClass="kt-stat-note"/>
    </VBox>
    <VBox spacing="7" styleClass="kt-stat-card kt-card-amber" maxWidth="Infinity" minHeight="110" prefHeight="118" style="-fx-background-color: #FFF3E6; -fx-background-radius: 14; -fx-border-color: #F8DEC0; -fx-border-radius: 14; -fx-border-width: 1; -fx-padding: 15 20;" HBox.hgrow="ALWAYS">
      <HBox alignment="CENTER_LEFT" spacing="8">
        <Label text="✦" styleClass="kt-stat-icon"/>
        <Label text="Khách tháng này" styleClass="kt-stat-name"/>
      </HBox>
      <Label text="—" styleClass="kt-stat-number kt-amber-text" fx:id="lblKhachThang" style="-fx-text-fill: #B06A13; -fx-font-weight: bold; -fx-font-size: 30px;"/>
      <Label text="Số khách khác nhau theo CCCD" styleClass="kt-stat-note"/>
    </VBox>
  </HBox>
  <TabPane tabClosingPolicy="UNAVAILABLE" styleClass="kt-tabs" VBox.vgrow="ALWAYS">
    <tabs>
      <Tab text="Danh bạ khách">
        <VBox spacing="11" styleClass="kt-panel">
          <Label text="Danh bạ khách thăm" styleClass="kt-panel-title"/>
          <Label text="Lưu hồ sơ khách riêng biệt, mỗi số CCCD chỉ tồn tại một lần." styleClass="kt-hint"/>
          <HBox spacing="9" alignment="CENTER_LEFT">
            <TextField fx:id="txtTimKhach" promptText="Tìm tên khách, CCCD hoặc ID..." HBox.hgrow="ALWAYS" styleClass="kt-search"/>
            <Button text="+  Thêm khách" onAction="#themKhach" styleClass="kt-button-primary"/>
            <Button text="✎  Sửa" onAction="#suaKhach" styleClass="kt-button-soft"/>
            <Button text="×  Xóa" onAction="#xoaKhach" styleClass="kt-button-danger"/>
          </HBox>
          <TableView fx:id="tblKhach" prefHeight="390" VBox.vgrow="ALWAYS" styleClass="kt-table">
            <placeholder>
              <Label text="Không có hồ sơ khách"/>
            </placeholder>
            <columns>
              <TableColumn fx:id="colKhachId" text="ID khách" prefWidth="110"/>
              <TableColumn fx:id="colCccd" text="CMT / CCCD" prefWidth="230"/>
              <TableColumn fx:id="colKhachTen" text="Họ và tên khách" prefWidth="355"/>
              <TableColumn fx:id="colKhachSinh" text="Ngày sinh" prefWidth="180"/>
            </columns>
          </TableView>
          <Label fx:id="lblKhachCount" text="Hiển thị: —" styleClass="kt-hint"/>
        </VBox>
      </Tab>
      <Tab text="Lượt đến thăm">
        <VBox spacing="11" styleClass="kt-panel">
          <HBox alignment="CENTER_LEFT" spacing="12" styleClass="kt-panel-heading">
            <Label text="Lượt khách đến và rời ký túc xá" styleClass="kt-panel-title"/>
            <Region minWidth="8" HBox.hgrow="ALWAYS"/>
            <HBox alignment="CENTER_LEFT" spacing="6" styleClass="kt-active-flag">
              <Label text="●  Đang thăm:" styleClass="kt-active-label"/>
              <Label text="—" styleClass="kt-active-count" fx:id="lblDangTham"/>
            </HBox>
          </HBox>
          <Label text="Chọn khách và sinh viên để ghi nhận lượt mới; xác nhận rời khi khách check-out." styleClass="kt-hint"/>
          <HBox alignment="CENTER_LEFT" spacing="9">
            <ComboBox fx:id="cboKhach" promptText="Chọn khách đến thăm" prefWidth="310" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
            <ComboBox fx:id="cboSinhVien" promptText="Chọn sinh viên được thăm" prefWidth="310" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
            <Button text="✓ Ghi nhận đến" onAction="#checkIn" styleClass="kt-button-primary"/>
          </HBox>
          <HBox alignment="CENTER_LEFT" spacing="9">
            <TextField fx:id="txtTimLuot" promptText="Tìm lượt theo ID, tên, CCCD, mã SV..." HBox.hgrow="ALWAYS" styleClass="kt-search"/>
            <Button text="↗ Xác nhận rời KTX" onAction="#checkOut" styleClass="kt-button-green"/>
            <Button text="✎ Sửa lượt" onAction="#suaLuot" styleClass="kt-button-soft"/>
            <Button text="× Xóa lượt" onAction="#xoaLuot" styleClass="kt-button-danger"/>
          </HBox>
          <TableView fx:id="tblLuot" prefHeight="390" VBox.vgrow="ALWAYS" styleClass="kt-table">
            <placeholder>
              <Label text="Chưa có lượt đến thăm"/>
            </placeholder>
            <columns>
              <TableColumn fx:id="colLuotId" text="ID lượt" prefWidth="75"/>
              <TableColumn fx:id="colLuotKhach" text="Tên khách" prefWidth="210"/>
              <TableColumn fx:id="colLuotCccd" text="CCCD" prefWidth="145"/>
              <TableColumn fx:id="colLuotSv" text="Sinh viên được thăm" prefWidth="250"/>
              <TableColumn fx:id="colLuotDen" text="Thời gian đến" prefWidth="180"/>
              <TableColumn fx:id="colLuotDi" text="Thời gian đi" prefWidth="170"/>
              <TableColumn fx:id="colLuotStatus" text="Trạng thái" prefWidth="200"/>
            </columns>
          </TableView>
          <Label fx:id="lblLuotCount" text="Hiển thị: —" styleClass="kt-hint"/>
        </VBox>
      </Tab>
      <Tab text="Thống kê khách thăm">
        <VBox spacing="11" styleClass="kt-panel">
          <Label text="Thống kê lượt khách đến thăm theo tháng" styleClass="kt-panel-title"/>
          <Label text="Tổng hợp theo từng cặp sinh viên – khách; nhiều lần trong một ngày vẫn tính nhiều lượt." styleClass="kt-hint"/>
          <HBox spacing="10" alignment="CENTER_LEFT" styleClass="kt-filter-box">
            <Label text="Tháng thống kê (YYYY-MM)" styleClass="kt-field-label"/>
            <TextField fx:id="txtThang" text="2026-11" promptText="Ví dụ: 2026-11" prefWidth="150"/>
            <Button text="Tra cứu" onAction="#traCuuThongKe" styleClass="kt-button-primary"/>
          </HBox>
          <Label fx:id="lblThongKe" text="Nhập tháng để xem thống kê" styleClass="kt-summary"/>
          <TableView fx:id="tblThongKe" prefHeight="390" VBox.vgrow="ALWAYS" styleClass="kt-table">
            <placeholder>
              <Label text="Không có lượt thăm trong tháng đã chọn"/>
            </placeholder>
            <columns>
              <TableColumn fx:id="colTkSv" text="Mã SV" prefWidth="135"/>
              <TableColumn fx:id="colTkTenSv" text="Họ tên SV" prefWidth="180"/>
              <TableColumn fx:id="colTkLop" text="Lớp" prefWidth="125"/>
              <TableColumn fx:id="colTkPhong" text="Phòng" prefWidth="90"/>
              <TableColumn fx:id="colTkCccd" text="CCCD khách" prefWidth="155"/>
              <TableColumn fx:id="colTkTenKhach" text="Tên khách" prefWidth="220"/>
              <TableColumn fx:id="colTkNgaySinh" text="Ngày sinh khách" prefWidth="135"/>
              <TableColumn fx:id="colTkSoLan" text="Số lần đến" prefWidth="110"/>
              <TableColumn fx:id="colTkNgayGan" text="Ngày đến gần nhất" prefWidth="170"/>
            </columns>
          </TableView>
        </VBox>
      </Tab>
    </tabs>
  </TabPane>
</VBox>
