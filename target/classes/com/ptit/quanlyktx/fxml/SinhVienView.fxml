<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!-- Các class sv-* chỉ ảnh hưởng đến màn hình Sinh viên. -->
<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.ptit.quanlyktx.controller.SinhVienController"
      stylesheets="@../css/sinhvien.css"
      styleClass="sv-root"
      spacing="16" fillWidth="true">

    <!-- Thống kê thực tế từ danh sách đọc qua SinhVienDAO.findAll(). -->
    <HBox spacing="14" alignment="CENTER_LEFT">
        <VBox styleClass="sv-stat-blue" spacing="8"
              prefWidth="280" maxWidth="Infinity" HBox.hgrow="ALWAYS">
            <HBox spacing="8" alignment="CENTER_LEFT">
                <Label text="◈" styleClass="sv-icon-blue" />
                <Label text="Tổng sinh viên" styleClass="sv-stat-label" />
            </HBox>
            <Label fx:id="lblTotalStudents" text="—" styleClass="sv-number-blue" />
            <Label text="Đang được quản lý trong KTX" styleClass="sv-stat-note" />
        </VBox>
        <VBox styleClass="sv-stat-green" spacing="8"
              prefWidth="280" maxWidth="Infinity" HBox.hgrow="ALWAYS">
            <HBox spacing="8" alignment="CENTER_LEFT">
                <Label text="▣" styleClass="sv-icon-green" />
                <Label text="Phòng có sinh viên" styleClass="sv-stat-label" />
            </HBox>
            <Label fx:id="lblOccupiedRooms" text="—" styleClass="sv-number-green" />
            <Label text="Số phòng đang có người ở" styleClass="sv-stat-note" />
        </VBox>
        <VBox styleClass="sv-stat-amber" spacing="8"
              prefWidth="280" maxWidth="Infinity" HBox.hgrow="ALWAYS">
            <HBox spacing="8" alignment="CENTER_LEFT">
                <Label text="✦" styleClass="sv-icon-amber" />
                <Label text="SV vào ở tháng này" styleClass="sv-stat-label" />
            </HBox>
            <Label fx:id="lblNewThisMonth" text="—" styleClass="sv-number-amber" />
            <Label text="Theo ngày vào ở trong MySQL" styleClass="sv-stat-note" />
        </VBox>
    </HBox>

    <!-- Danh sách và các chức năng CRUD giữ nguyên fx:id/onAction. -->
    <VBox spacing="14" styleClass="sv-panel" VBox.vgrow="ALWAYS">
        <VBox spacing="4">
            <Label text="Danh sách sinh viên nội trú" styleClass="sv-section-title" />
            <Label text="Tra cứu và cập nhật hồ sơ sinh viên từ MySQL"
                   styleClass="sv-section-note" />
        </VBox>

        <HBox spacing="9" alignment="CENTER_LEFT">
            <TextField fx:id="txtSearch"
                       promptText="Tìm mã SV, họ tên, CCCD, lớp, quê quán hoặc phòng..."
                       styleClass="sv-search"
                       prefHeight="40" HBox.hgrow="ALWAYS" />
            <Button text="＋ Thêm sinh viên" onAction="#handleAdd"
                    styleClass="sv-add-button" prefHeight="40" />
            <Button text="✎ Sửa" onAction="#handleEdit"
                    styleClass="sv-edit-button" prefHeight="40" />
            <Button text="× Xóa" onAction="#handleDelete"
                    styleClass="sv-delete-button" prefHeight="40" />
            <Button text="↻ Làm mới" onAction="#handleRefresh"
                    styleClass="sv-refresh-button" prefHeight="40" />
        </HBox>

        <!-- Không đặt CONSTRAINED_RESIZE_POLICY trong FXML: tránh lỗi ép kiểu đã gặp.
             Controller sẽ thiết lập columnResizePolicy bằng Java. -->
        <TableView fx:id="tableStudents" styleClass="sv-table"
                   prefHeight="470" minHeight="260" VBox.vgrow="ALWAYS">
            <placeholder>
                <Label text="Không có sinh viên phù hợp" styleClass="sv-empty-text" />
            </placeholder>
            <columns>
                <TableColumn fx:id="colMaSV" text="Mã sinh viên" prefWidth="138" />
                <TableColumn fx:id="colHoTen" text="Họ và tên" prefWidth="185" />
                <TableColumn fx:id="colSoCmt" text="Số CMT/CCCD" prefWidth="142" />
                <TableColumn fx:id="colNgaySinh" text="Ngày sinh" prefWidth="105" />
                <TableColumn fx:id="colLop" text="Lớp" prefWidth="130" />
                <TableColumn fx:id="colQueQuan" text="Quê quán" prefWidth="140" />
                <TableColumn fx:id="colSoPhong" text="Phòng" prefWidth="85" />
                <TableColumn fx:id="colNgayVaoO" text="Ngày vào ở" prefWidth="110" />
            </columns>
        </TableView>

        <HBox alignment="CENTER_LEFT">
            <Label fx:id="lblCount" text="Hiển thị: 0 / 0 sinh viên"
                   styleClass="sv-footer-count" />
        </HBox>
    </VBox>
</VBox>
