<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<!-- Nạp vào contentArea của MainView.fxml, không tạo sidebar mới. -->
<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.ptit.quanlyktx.controller.GuiXeController"
      stylesheets="@../css/guixe.css" styleClass="parking-page"
      spacing="14" fillWidth="true" minWidth="930">

    <HBox alignment="CENTER_LEFT" spacing="10">
        <VBox spacing="4" HBox.hgrow="ALWAYS">
            <Label text="QUẢN LÝ VÉ XE THÁNG VÀ HOẠT ĐỘNG RA / VÀO" styleClass="parking-overline"/>
            <Label text="Tra cứu vé xe, kiểm soát xe trong bãi và lịch sử gửi/lấy" styleClass="parking-subtitle"/>
        </VBox>
        <Label text="THÁNG VÉ" styleClass="parking-month-label"/>
        <TextField fx:id="txtMonth" prefWidth="115" minWidth="115"
                   promptText="YYYY-MM" onAction="#handleApplyMonth"
                   styleClass="parking-month-input"/>
        <Button text="Xem" onAction="#handleApplyMonth" styleClass="parking-month-apply"/>
    </HBox>

    <HBox spacing="13" fillHeight="true">
        <VBox HBox.hgrow="ALWAYS" maxWidth="1.7976931348623157E308"
              spacing="7" styleClass="parking-stat, parking-stat-blue">
            <HBox alignment="CENTER_LEFT" spacing="8">
                <Label text="◈" styleClass="parking-stat-icon-blue"/>
                <Label text="Tổng vé tháng" styleClass="parking-stat-caption"/>
            </HBox>
            <Label fx:id="lblTickets" text="—" styleClass="parking-stat-value-blue"/>
        </VBox>
        <VBox HBox.hgrow="ALWAYS" maxWidth="1.7976931348623157E308"
              spacing="7" styleClass="parking-stat, parking-stat-green">
            <HBox alignment="CENTER_LEFT" spacing="8">
                <Label text="♟" styleClass="parking-stat-icon-green"/>
                <Label text="Sinh viên đăng ký" styleClass="parking-stat-caption"/>
            </HBox>
            <Label fx:id="lblStudents" text="—" styleClass="parking-stat-value-green"/>
        </VBox>
        <VBox HBox.hgrow="ALWAYS" maxWidth="1.7976931348623157E308"
              spacing="7" styleClass="parking-stat, parking-stat-amber">
            <HBox alignment="CENTER_LEFT" spacing="8">
                <Label text="◉" styleClass="parking-stat-icon-amber"/>
                <Label text="Doanh thu vé tháng" styleClass="parking-stat-caption"/>
            </HBox>
            <Label fx:id="lblRevenue" text="—" styleClass="parking-stat-value-amber"/>
        </VBox>
    </HBox>

    <TabPane fx:id="tabPane" tabClosingPolicy="UNAVAILABLE"
             styleClass="parking-tabs" prefHeight="610" VBox.vgrow="ALWAYS">
        <tabs>
            <Tab text="◈  Vé tháng" closable="false">
                <content>
                    <VBox styleClass="parking-panel" spacing="13" fillWidth="true">
                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <VBox spacing="4" HBox.hgrow="ALWAYS">
                                <Label text="Danh sách vé xe tháng" styleClass="parking-panel-title"/>
                                <Label text="Nhấp đúp vào vé để xem thông tin chi tiết" styleClass="parking-muted"/>
                            </VBox>
                            <Label text="VE_XE_THANG" styleClass="parking-tag"/>
                        </HBox>
                        <HBox alignment="CENTER_LEFT" spacing="8">
                            <TextField fx:id="txtTicketSearch" HBox.hgrow="ALWAYS" prefHeight="39"
                                       promptText="⌕  Tìm mã vé, biển số, tên sinh viên..."
                                       styleClass="parking-search"/>
                            <Button text="＋ Đăng ký vé" onAction="#handleAddTicket" styleClass="parking-primary"/>
                            <Button text="Sửa" onAction="#handleEditTicket" styleClass="parking-outline"/>
                            <Button text="Xóa" onAction="#handleDeleteTicket" styleClass="parking-outline"/>
                            <Button text="⟳" onAction="#handleRefreshTickets" styleClass="parking-outline"/>
                        </HBox>
                        <TableView fx:id="tableTickets" styleClass="parking-table" prefHeight="350"
                                   VBox.vgrow="ALWAYS">
                            <placeholder><Label text="Không có vé trong tháng hoặc không khớp bộ lọc"/></placeholder>
                            <columns>
                                <TableColumn fx:id="colTicketId" text="Mã vé" prefWidth="112"/>
                                <TableColumn fx:id="colTicketPlate" text="Biển số" prefWidth="126"/>
                                <TableColumn fx:id="colTicketType" text="Loại xe" prefWidth="160"/>
                                <TableColumn fx:id="colTicketStudent" text="Sinh viên" prefWidth="210"/>
                                <TableColumn fx:id="colTicketMonth" text="Tháng" prefWidth="88"/>
                                <TableColumn fx:id="colTicketFee" text="Phí vé" prefWidth="105"/>
                                <TableColumn fx:id="colTicketStatus" text="Trạng thái" prefWidth="112"/>
                            </columns>
                        </TableView>
                        <HBox alignment="CENTER_LEFT" spacing="8">
                            <Label fx:id="lblTicketCount" text="Hiển thị: —" styleClass="parking-muted"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Button text="Xem chi tiết" onAction="#handleTicketDetail" styleClass="parking-ghost"/>
                            <Button text="↻ Gia hạn" onAction="#handleRenewTicket" styleClass="parking-outline-success"/>
                        </HBox>
                    </VBox>
                </content>
            </Tab>

            <Tab text="⇄  Gửi / Lấy xe" closable="false">
                <content>
                    <VBox spacing="11" fillWidth="true">
                        <HBox spacing="12" fillHeight="true" VBox.vgrow="ALWAYS">
                            <VBox spacing="12" HBox.hgrow="ALWAYS" maxWidth="1.7976931348623157E308"
                                  styleClass="parking-panel" prefWidth="450">
                                <HBox alignment="CENTER_LEFT" spacing="8">
                                    <Label text="⌕" styleClass="parking-panel-icon"/>
                                    <Label text="Tra cứu biển số" styleClass="parking-panel-title"/>
                                </HBox>
                                <HBox spacing="8" alignment="CENTER_LEFT">
                                    <TextField fx:id="txtPlate" HBox.hgrow="ALWAYS" prefHeight="40"
                                               promptText="Ví dụ: 29B1-12345" styleClass="parking-search"
                                               onAction="#handleLookupPlate"/>
                                    <Button text="Tra cứu" onAction="#handleLookupPlate" styleClass="parking-primary"/>
                                </HBox>
                                <VBox fx:id="boxVehicle" spacing="9" styleClass="parking-vehicle-card">
                                    <HBox spacing="11" alignment="CENTER_LEFT">
                                        <Label text="▣" styleClass="parking-vehicle-icon"/>
                                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                                            <Label fx:id="lblPlate" text="Chưa tra cứu xe" styleClass="parking-vehicle-plate"/>
                                            <Label fx:id="lblOwner" text="Nhập biển số để xem thông tin" styleClass="parking-muted" wrapText="true"/>
                                            <Label fx:id="lblOwnerInfo" text="" styleClass="parking-muted" wrapText="true"/>
                                        </VBox>
                                    </HBox>
                                    <Separator/>
                                    <HBox alignment="CENTER_LEFT">
                                        <Label text="Vé tháng" styleClass="parking-key" HBox.hgrow="ALWAYS"/>
                                        <Label fx:id="lblValidity" text="—" styleClass="parking-status-neutral"/>
                                    </HBox>
                                    <HBox alignment="CENTER_LEFT">
                                        <Label text="Loại xe" styleClass="parking-key" HBox.hgrow="ALWAYS"/>
                                        <Label fx:id="lblVehicleType" text="—" styleClass="parking-info"/>
                                    </HBox>
                                    <HBox alignment="CENTER_LEFT">
                                        <Label text="Mã vé" styleClass="parking-key" HBox.hgrow="ALWAYS"/>
                                        <Label fx:id="lblVehicleId" text="—" styleClass="parking-info"/>
                                    </HBox>
                                </VBox>
                                <HBox alignment="CENTER_LEFT" styleClass="parking-free-card" spacing="8">
                                    <Label text="♧" styleClass="parking-free-icon"/>
                                    <Label text="Lượt miễn phí còn lại hôm nay" styleClass="parking-free-label" HBox.hgrow="ALWAYS"/>
                                    <Label fx:id="lblFreeCount" text="— / 2" styleClass="parking-free-value"/>
                                </HBox>
                                <HBox spacing="9">
                                    <Button fx:id="btnCheckIn" text="↧  GHI NHẬN GỬI"
                                            maxWidth="1.7976931348623157E308" HBox.hgrow="ALWAYS"
                                            onAction="#handleCheckIn" styleClass="parking-action-blue"/>
                                    <Button fx:id="btnCheckOut" text="↥  XÁC NHẬN LẤY"
                                            maxWidth="1.7976931348623157E308" HBox.hgrow="ALWAYS"
                                            onAction="#handleCheckOutSelected" styleClass="parking-action-teal"/>
                                </HBox>
                                <Label fx:id="lblGateHint" text="Tra cứu biển số để bắt đầu thao tác."
                                       styleClass="parking-muted" wrapText="true"/>
                            </VBox>

                            <VBox spacing="11" HBox.hgrow="ALWAYS" maxWidth="1.7976931348623157E308"
                                  styleClass="parking-panel" prefWidth="545">
                                <HBox alignment="CENTER_LEFT" spacing="8">
                                    <Label text="▣" styleClass="parking-panel-icon"/>
                                    <Label text="Xe đang trong bãi" styleClass="parking-panel-title" HBox.hgrow="ALWAYS"/>
                                    <Label fx:id="lblParked" text="0 xe" styleClass="parking-tag-green"/>
                                </HBox>
                                <TableView fx:id="tableOpen" styleClass="parking-table"
                                           prefHeight="395" VBox.vgrow="ALWAYS">
                                    <placeholder><Label text="Hiện không có xe đang trong bãi"/></placeholder>
                                    <columns>
                                        <TableColumn fx:id="colOpenPlate" text="Biển số" prefWidth="122"/>
                                        <TableColumn fx:id="colOpenTime" text="Giờ vào" prefWidth="134"/>
                                        <TableColumn fx:id="colOpenStudent" text="Sinh viên" prefWidth="160"/>
                                        <TableColumn fx:id="colOpenAction" text="Thao tác" prefWidth="125"/>
                                    </columns>
                                </TableView>
                                <HBox alignment="CENTER_RIGHT" spacing="8">
                                    <Label text="Phí phát sinh hôm nay" styleClass="parking-muted"/>
                                    <Label fx:id="lblTodayFees" text="—" styleClass="parking-today-value"/>
                                    <Button text="⟳" onAction="#handleRefreshGate" styleClass="parking-outline"/>
                                </HBox>
                            </VBox>
                        </HBox>
                    </VBox>
                </content>
            </Tab>

            <Tab text="◷  Lịch sử" closable="false">
                <content>
                    <VBox spacing="12" styleClass="parking-panel" fillWidth="true">
                        <HBox alignment="CENTER_LEFT" spacing="8">
                            <Label text="◷" styleClass="parking-panel-icon"/>
                            <Label text="Lịch sử gửi / lấy xe" styleClass="parking-panel-title" HBox.hgrow="ALWAYS"/>
                            <Label text="LUOT_GUI_XE" styleClass="parking-tag"/>
                        </HBox>
                        <HBox spacing="9" alignment="BOTTOM_LEFT">
                            <VBox spacing="4">
                                <Label text="Từ ngày" styleClass="parking-field-caption"/>
                                <DatePicker fx:id="dpFrom" prefWidth="142"/>
                            </VBox>
                            <VBox spacing="4">
                                <Label text="Đến ngày" styleClass="parking-field-caption"/>
                                <DatePicker fx:id="dpTo" prefWidth="142"/>
                            </VBox>
                            <TextField fx:id="txtHistorySearch" HBox.hgrow="ALWAYS"
                                       promptText="⌕  Biển số, mã vé, mã SV..." prefHeight="38"
                                       styleClass="parking-search"/>
                            <ComboBox fx:id="cbHistoryStatus" prefWidth="135"/>
                            <Button text="Tra cứu" onAction="#handleSearchHistory" styleClass="parking-primary"/>
                            <Button text="⟳" onAction="#handleRefreshHistory" styleClass="parking-outline"/>
                        </HBox>
                        <TableView fx:id="tableHistory" styleClass="parking-table" prefHeight="350"
                                   VBox.vgrow="ALWAYS">
                            <placeholder><Label text="Không có lượt gửi xe phù hợp"/></placeholder>
                            <columns>
                                <TableColumn fx:id="colHistoryId" text="ID" prefWidth="54"/>
                                <TableColumn fx:id="colHistoryPlate" text="Biển số" prefWidth="120"/>
                                <TableColumn fx:id="colHistoryStudent" text="Sinh viên" prefWidth="177"/>
                                <TableColumn fx:id="colHistoryIn" text="Thời gian gửi" prefWidth="145"/>
                                <TableColumn fx:id="colHistoryOut" text="Thời gian lấy" prefWidth="145"/>
                                <TableColumn fx:id="colHistoryFee" text="Phí phát sinh" prefWidth="110"/>
                                <TableColumn fx:id="colHistoryState" text="Trạng thái" prefWidth="105"/>
                            </columns>
                        </TableView>
                        <HBox alignment="CENTER_LEFT" spacing="8">
                            <Label fx:id="lblHistoryCount" text="0 lượt" styleClass="parking-muted"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label text="Tổng phí trong kết quả:" styleClass="parking-muted"/>
                            <Label fx:id="lblHistoryFees" text="0đ" styleClass="parking-today-value"/>
                        </HBox>
                    </VBox>
                </content>
            </Tab>
        </tabs>
    </TabPane>
</VBox>
