<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.ptit.quanlyktx.controller.MainController"
            prefWidth="1150" prefHeight="720" styleClass="app-root">
    <left>
        <VBox prefWidth="225" spacing="9" styleClass="sidebar">
            <padding><Insets top="25" right="14" bottom="18" left="14"/></padding>
            <Label text="PTIT KTX" styleClass="brand"/>
            <Label text="QUẢN LÝ KÍ TÚC XÁ" styleClass="brand-sub"/>
            <Separator/>
            <Button text="⌂  Tổng quan" onAction="#showDashboard" maxWidth="Infinity" styleClass="nav-button"/>
            <Button text="◉  Sinh viên" onAction="#showStudents" maxWidth="Infinity" styleClass="nav-button"/>
            <Button text="▣  Phòng ở" onAction="#showRooms" maxWidth="Infinity" styleClass="nav-button"/>
            <Button text="♧  Khách thăm" onAction="#showVisitors" maxWidth="Infinity" styleClass="nav-button"/>
            <Button text="✦  Dịch vụ" onAction="#showServices" maxWidth="Infinity" styleClass="nav-button"/>
            <Button text="▤  Gửi xe" onAction="#showParking" maxWidth="Infinity" styleClass="nav-button"/>
            <Button text="▧  Hóa đơn" onAction="#showBills" maxWidth="Infinity" styleClass="nav-button"/>
            <Button text="▥  Thống kê" onAction="#showReports" maxWidth="Infinity" styleClass="nav-button"/>
            <Region VBox.vgrow="ALWAYS"/>

        </VBox>
    </left>
    <center>
        <VBox spacing="23" styleClass="main-content">
            <padding><Insets top="28" right="32" bottom="28" left="32"/></padding>
            <HBox alignment="CENTER_LEFT">
                <VBox spacing="4">
                    <Label text="HỆ THỐNG QUẢN LÝ KÝ TÚC XÁ" styleClass="eyebrow"/>
                    <Label fx:id="pageTitle" text="Tổng quan" styleClass="page-title"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <Label text="PTIT · Quản trị viên" styleClass="user-label"/>
            </HBox>
            <VBox fx:id="contentArea" spacing="22" VBox.vgrow="ALWAYS"/>
        </VBox>
    </center>
</BorderPane>
